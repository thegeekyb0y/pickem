# Runtime: Neon’s pooled connection URL (the hostname includes -pooler).
# This is the name the Neon Vercel integration provides.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require

# Migrations: Neon’s direct connection URL, not the transaction pooler.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require

# Optional. Database connections per instance. Keep it small: serverless
# instances scale horizontally, so the total is instances x this value.
DATABASE_POOL_MAX=5

BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# The public origin of this deployment. Set it to the production URL in
# Production; previews get their own preview URL.
BETTER_AUTH_URL=http://localhost:3000
# Optional. Comma-separated origins allowed to make state-changing auth
# requests. Defaults to BETTER_AUTH_URL. Set it to the production URL only, so
# Google sign-in stays limited to the production domain.
BETTER_AUTH_TRUSTED_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BLOB_READ_WRITE_TOKEN=
UNSPLASH_ACCESS_KEY=

# Optional: point integration/E2E tests at a disposable branch.
DATABASE_URL_TEST=
ALLOW_TEST_DB_MUTATION=

# Optional: hostname only (no credentials) of the production database. The
# test suites refuse to run when the target host matches it.
PRODUCTION_DATABASE_HOST=

# Preview-only load-test route. Never set these in production.
ENABLE_LOAD_TEST_ROUTES=
LOAD_TEST_SECRET=

# Optional. Allows a k6 target on localhost or 127.0.0.1 for local runs.
LOAD_TEST_ALLOW_LOCALHOST=
