# Runtime: use Neon’s pooled connection URL (the hostname includes -pooler).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require

# Optional. When set, this takes precedence over DATABASE_URL at runtime.
# Useful when the pooled and direct URLs are kept under separate names.
DATABASE_URL_POOLED=

# Drizzle migrations: use the direct Neon URL, not the transaction pooler.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require

# Optional. Database connections per instance. Keep it small: serverless
# instances scale horizontally, so the total is instances x this value.
DATABASE_POOL_MAX=5

BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BLOB_READ_WRITE_TOKEN=

# Optional: point integration/E2E tests at a disposable branch.
DATABASE_URL_TEST=
ALLOW_TEST_DB_MUTATION=

# Optional: hostname only (no credentials) of the production database. The
# test suites refuse to run when the target host matches it.
PRODUCTION_DATABASE_HOST=

# Preview-only load-test route. Never set these in production.
ENABLE_LOAD_TEST_ROUTES=
LOAD_TEST_SECRET=
